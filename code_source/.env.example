# Use a real Postgres database (locally or AWS RDS). This is a template only.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ecommerce
DB_USER=ecommerce
DB_PASSWORD=<your-database-password>
# Generate with: openssl rand -base64 32
APP_JWT_SECRET_BASE64=<your-base64-secret>
APP_JWT_ISSUER=ecommerce-monolith
APP_JWT_EXPIRATION_MINUTES=60
APP_SEED_PRODUCTS_ENABLED=true
# APP_ADMIN_PASSWORD=<admin-password-at-least-12-chars> # gitleaks:allow
# API_DOCS_ENABLED=true # gitleaks:allow
