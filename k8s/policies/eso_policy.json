{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowESOToReadSecrets",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:GetSecretValue",
        "secretsmanager:DescribeSecret"
      ],
      "Resource": "arn:aws:secretsmanager:us-east-1:<ACCOUNT_ID>:secret:kube-secret-yQ135W"
    }
  ]
}
